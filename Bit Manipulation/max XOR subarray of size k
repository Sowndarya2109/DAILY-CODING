class Solution {
    public int maxSubarrayXOR(int[] arr, int k) {
         int xor = 0;
         for(int i=0; i<k; i++){
             xor = xor ^ arr[i];
         }
         int maxXOR = xor;
         for(int i=k; i<arr.length; i++){
             xor = xor ^ arr[i-k];
             xor = xor ^ arr[i];
             maxXOR = Math.max(xor, maxXOR);
         }
         return maxXOR;
    }
}
