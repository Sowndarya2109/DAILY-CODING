class Solution {
    public static boolean checkPangram(String s) {
        int freq[] = new int[26];
        for(int i=0; i<s.length(); i++){
            char c = Character.toLowerCase(s.charAt(i));
            if(c >= 'a' && c <= 'z')
                freq[c - 'a']++;
        }
        for(int x : freq){
            if(x == 0){
                return false;
            }
        }
       return true;
    }
}
