class Solution {
    public boolean isTwistedPrime(int n) {
        if(!isPrime(n)){
            return false;
        }
        int rev = 0;
        while(n > 0){
            int rem = n%10;
            rev = rev * 10 + rem;
            n = n/10;
        }
        if(isPrime(rev)){
            return true;
        }
        return false;
    }
    public boolean isPrime(int n){
        if(n < 2){
            return false;
        }
        for(int i=2; i*i<=n; i++){
            if(n%i == 0){
                return false;
            }
        }
        return true;
    }
}
