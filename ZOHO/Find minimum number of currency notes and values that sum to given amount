
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	
		Scanner sc = new Scanner(System.in);
		int amo = sc.nextInt();
		int notes[] = {2000, 500, 200, 100, 50, 20, 10, 5, 1};
		int count[] = new int[9];
		
		for(int i=0; i<9; i++){
		    if(amo >= notes[i]){
		        count[i] = amo / notes[i];
		        amo = amo % notes[i];
		    }
		}
		for(int i=0; i<9; i++){
		    if(count[i] > 0){
		         System.out.println(notes[i] + " : " + count[i]);
		    }
		   
		}
	}
}
