
class Solution {
    static ArrayList<Integer> subarraySum(int[] arr, int target) {
       ArrayList<Integer> ans = new ArrayList<>();
       
        int sum = 0;
        int left = 0;
        for(int i=0; i<arr.length; i++){
            sum += arr[i];
            while(sum > target){
               sum -= arr[left];
               left++;
           }
            if(sum == target){
                ans.add(left+1);
                ans.add(i+1);
                return ans;
            }
        }
        ans.add(-1);
        return ans;
    }
}
